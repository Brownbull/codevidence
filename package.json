{
  "name": "candidate-skill-scanner",
  "version": "0.1.0",
  "description": "Chrome-only SPA + local Node.js scan pipeline that discovers developer talent by analysing public GitHub repositories.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --port 3000",
    "dev:website": "vite --port 3000",
    "dev:test:website": "vite --port 4000",
    "build": "tsc --noEmit && vite build",
    "postbuild": "pnpm build:optimize",
    "build:optimize": "classpresso optimize",
    "preview": "vite preview --port 3000",
    "start": "vite preview --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm test:kill-ports && playwright test",
    "test:e2e:ui": "pnpm test:kill-ports && playwright test --ui",
    "test:e2e:headed": "pnpm test:kill-ports && playwright test --headed",
    "test:e2e:chromium": "pnpm test:kill-ports && playwright test --project=chromium",
    "test:e2e:report": "playwright show-report",
    "test:kill-ports": "lsof -ti:4000,4010,4020 | xargs kill -9 2>/dev/null || true",
    "lint": "tsc --noEmit",
    "scan": "tsx src/pipeline/index.ts",
    "admin:ops": "tsx scripts/admin-ops.ts",
    "db:query": "tsx scripts/db-query.ts",
    "db:query:list": "tsx scripts/db-query.ts --list",
    "db:seed": "tsx scripts/seed-taxonomy.ts",
    "ai:monitor": "npx @rulecatch/ai-pooler monitor --no-api-key",
    "clean": "rm -rf dist coverage test-results playwright-report",
    "precommit": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@octokit/rest": "^20.1.1",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.66.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^12.1.0",
    "firebase": "^11.3.1",
    "firebase-admin": "^13.1.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.29.0",
    "simple-git": "^3.27.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2",
    "zustand": "^4.5.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "classpresso": "^1.7.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^2.1.9"
  }
}
