rules_version = '2';

// ─── Firestore Security Rules — candidate-skill-scanner ───────────────────────
//
// Three-tier access model:
//   Tier 1 — Unauthenticated: NO access to any collection
//   Tier 2 — Authenticated non-admin: read-only on candidates, repositories, taxonomy
//   Tier 3 — Authenticated admin (custom claim admin: true): read + write on ALL collections
//
// Admin status is determined solely by Firebase ID token custom claim `admin: true`.
// It is NEVER read from Firestore or client-side state.

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────────

    /** Returns true if the request comes from a signed-in user. */
    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * Returns true if the signed-in user has the admin custom claim.
     * This is the sole admin gate — never use Firestore docs for this.
     */
    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.admin == true;
    }

    // ─── candidates ─────────────────────────────────────────────────────────

    match /candidates/{candidateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── repositories ────────────────────────────────────────────────────────

    match /repositories/{repoId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── taxonomy ────────────────────────────────────────────────────────────

    match /taxonomy/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── user_profiles ──────────────────────────────────────────────────────
    // Users can read/write their own profile (restricted fields).
    // Admins can read any profile. Pipeline uses Admin SDK (bypasses rules).

    match /user_profiles/{uid} {
      // Owner + admin can read
      allow read: if isAuthenticated()
        && (request.auth.uid == uid || isAdmin());

      // Owner can create with client-writable fields only
      allow create: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasAll(['uid', 'githubUsername', 'createdAt', 'updatedAt'])
        && !request.resource.data.keys().hasAny([
             'githubProvider', 'githubConnectedAt', 'tokenStatus',
             'lastSelfScanAt', 'selfScanCount'
           ]);

      // Owner can update only githubUsername + updatedAt
      allow update: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['githubUsername', 'updatedAt']);

      // Admin can write (for support operations)
      allow write: if isAdmin();

      // ─── secrets subcollection ────────────────────────────────────────────
      // Owner + admin can read secrets. Admin needs read access so the
      // pipeline worker (signed in as admin) can resolve encrypted tokens
      // for self-scan jobs without requiring a service account.
      // NO client writes — all writes go through Firebase Function.
      match /secrets/{secretId} {
        allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
        allow write: if false;
      }
    }

    // ─── scan_jobs ───────────────────────────────────────────────────────────
    // Admin: full read/write.
    // Authenticated users: can create self-scan jobs and read their own.

    match /scan_jobs/{jobId} {
      // Admin has full access
      allow read, write: if isAdmin();

      // Authenticated users can create self-scan jobs for themselves
      allow create: if isAuthenticated()
        && request.resource.data.type == 'self-scan'
        && request.resource.data.status == 'pending'
        && request.resource.data.payload.requestedBy == request.auth.uid
        && request.resource.data.payload.githubUsername ==
             get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.githubUsername
        && !('githubToken' in request.resource.data.payload);

      // Authenticated users can read their own self-scan jobs
      allow read: if isAuthenticated()
        && resource.data.type == 'self-scan'
        && resource.data.payload.requestedBy == request.auth.uid;
    }

    // ─── admin_flags ─────────────────────────────────────────────────────────
    // Admin-only. Non-admin users must never read admin_flags.

    match /admin_flags/{flagId} {
      allow read, write: if isAdmin();
    }
  }
}
